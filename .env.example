# ===== ActionGameDemo Server Environment =====

# Server port (WebSocket)
SERVER_PORT=9090

# JVM options
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=50

# Log level (DEBUG/INFO/WARN/ERROR)
# Note: logback.xml controls this, but can be overridden via system property
# JAVA_OPTS can include -Dlog.level=INFO

# ===== Future: LLM API =====
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=your-api-key-here
# LLM_MODEL=gpt-4o-mini

# ===== Persistence =====
MATCH_DB_URL=jdbc:mysql://localhost:3306/actiongame?useSSL=false&serverTimezone=UTC
MATCH_DB_USER=root
MATCH_DB_PASSWORD=actiongame
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Docker ports =====
MYSQL_PORT=3306
